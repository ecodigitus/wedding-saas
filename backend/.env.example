# Salin ke .env dan isi nilai asli. JANGAN commit .env asli.

# Database (port 5433 di host — 5432 dipakai proses Postgres lain di komputer ini)
DATABASE_URL=postgresql+psycopg://wedding:wedding@localhost:5433/wedding_saas

# Redis (cache & rate limiting)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=ganti-dengan-random-string-panjang-minimal-32-karakter
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# Enkripsi kolom PII privat (Guest.name, RSVP.guest_name — bukan buku tamu,
# itu memang publik by design). Generate sekali, simpan aman:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Hilang/ganti key = data lama TIDAK BISA didekripsi lagi.
PII_ENCRYPTION_KEY=

# Google OAuth (opsional untuk Fase 1 — isi saat sudah setup Google Cloud Console)
GOOGLE_CLIENT_ID=

# CORS — origin frontend yang diizinkan, pisahkan dengan koma. Tambahkan URL
# ngrok frontend di sini kalau perlu diakses dari luar (contoh:
# http://localhost:3000,https://xxxx.ngrok-free.dev)
CORS_ORIGINS=http://localhost:3000
# Kosongkan kecuali benar-benar butuh preview deployment dengan domain acak
# (mis. Vercel per-branch) — JANGAN pakai wildcard broad seperti
# "https://.*\.vercel\.app" di production, siapa saja bisa deploy ke situ
# (lihat task.v2.md security review, OWASP A05).
CORS_ORIGIN_REGEX=

# S3-compatible storage — Fase 3 (BT-03 Selfie Check-in). Bucket PRIVATE
# wajib (foto wajah tamu = PII sensitif), akses cuma lewat signed URL
# berdurasi pendek (lihat app/core/storage.py). Kosongkan S3_ENDPOINT_URL
# untuk pakai AWS S3 asli (boto3 resolve endpoint dari S3_REGION otomatis);
# isi S3_ENDPOINT_URL untuk MinIO lokal / provider S3-compatible lain
# (Cloudflare R2, Backblaze B2, dst).
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=dev-minio-user
S3_SECRET_KEY=dev-minio-password
S3_BUCKET_PRIVATE=wedding-saas-private-dev
S3_BUCKET_PUBLIC=
S3_REGION=us-east-1

# Xendit (beli paket/add-on per-acara). Ambil dari dashboard Xendit
# (Settings > API Keys untuk secret key, Settings > Webhooks untuk verification
# token). Kosongkan untuk mematikan billing (endpoint purchase akan
# menolak dengan pesan jelas, bukan crash). Harga & katalog paket/add-on ada
# di app/core/packages.py, bukan env var.
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
# Dipakai untuk redirect setelah bayar (success/failure_redirect_url Xendit).
FRONTEND_BASE_URL=http://localhost:3000

ENVIRONMENT=development
